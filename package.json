{
  "name": "heirs-of-the-astral-ring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "星環の継承者 ―アストラル・レガシー― : 完全オリジナル16bit風ブラウザRPG (縦切り版)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
