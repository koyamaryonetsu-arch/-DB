# ===== 必須 =====

# Anthropic(Claude) APIキー — https://console.anthropic.com で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# LINE Messaging API — LINE Developers コンソールで取得
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 任意 =====

# 使うモデル。デフォルトは安価な Haiku 4.5。
# より高品質にしたい場合は claude-sonnet-4-6 にする。
# CLAUDE_MODEL=claude-sonnet-4-6

# 1返信あたりの最大トークン数(デフォルト 1024)
# MAX_TOKENS=1024

# 会話メモリとして保持する直近のやり取り数(デフォルト 10)
# MEMORY_TURNS=10

# persona.json をファイルではなく環境変数で渡したい場合(Vercelデプロイ時に便利)。
# persona.json の中身をそのまま1行で貼り付ける。
# PERSONA_JSON={"me":"...","styleSummary":"...","examples":[...]}
