# Vercel の Project Settings → Environment Variables に同じ名前で設定してください
# （このファイル自体は値を持ちません。本物の値はリポジトリにコミットしない）

# Supabase Webhook 認証用（任意の長い文字列。生成: openssl rand -hex 32）
SUPABASE_WEBHOOK_SECRET=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 通知先のLINEグループID（line-webhook.js のログから取得）
LINE_TARGET_GROUP_ID=

# Anthropic API（AI初期対応判断用）
ANTHROPIC_API_KEY=
